# Append to .env — placeholders only. Never commit real values.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
MOTOGRIP_FEATURE_AFFILIATE=false
MOTOGRIP_FEATURE_ADSENSE=false
MOTOGRIP_FEATURE_DEALER_LOCATOR=true
MOTOGRIP_GUEST_COMMENTS=true
# Optional integrations (leave blank until you have real credentials)
GOOGLE_ANALYTICS_ID=
ADSENSE_PUBLISHER_ID=
GOOGLE_MAPS_API_KEY=
BACKUP_ARCHIVE_PASSWORD=
MOTOGRIP_CSP=true
# Backups. Disk "backups" is local storage; use an off-site disk (e.g. s3) in production.
BACKUP_DISK=backups
# The archive password lives ONLY here and in your password manager, never next to the backups.
# BACKUP_ARCHIVE_PASSWORD already listed above.
# Production session security
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
